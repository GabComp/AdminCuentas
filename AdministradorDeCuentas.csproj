<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>administrador-cuentas-comapa</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Evita que el proyecto principal compile el proyecto de pruebas. -->
    <Compile Remove="AdministradorDeCuentas.Tests\**" />
    <Content Remove="AdministradorDeCuentas.Tests\**" />
    <EmbeddedResource Remove="AdministradorDeCuentas.Tests\**" />
    <None Remove="AdministradorDeCuentas.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los secretos de producción se configuran en el servidor, no se publican. -->
    <Content Update="appsettings.Production.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
