@page "/pago-en-linea/retorno"
@using System.Globalization
@using AdministradorDeCuentas.Pages
@model PagoRetornoModel
@{
    Layout = "_LayoutPago";
    ViewData["Title"] = "Resultado del pago";
    ViewData["Description"] = "Validación del pago en línea de COMAPA Victoria.";
}

<section class="page-header text-center">
    <div class="container">
        <div class="breadcrumb">
            <a asp-page="/pago-en-linea">Pago en línea</a> / <span>Resultado</span>
        </div>
        <h1>Resultado del pago</h1>
    </div>
</section>

<section class="content-section">
    <div class="container" style="max-width: 780px;">
        @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
        {
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5 text-center">
                    <div class="display-5 text-danger mb-3">
                        <i class="fas fa-circle-exclamation"></i>
                    </div>
                    <h2 class="h3 mb-3" style="font-family: var(--font-heading); color: var(--color-gob-guinda);">
                        No se pudo completar el pago
                    </h2>
                    <div class="alert alert-danger text-start" role="alert">
                        @Model.MensajeError
                    </div>
                    <p class="text-muted">
                        Si el banco autorizó el cargo, conserva el comprobante o el correo de la pasarela
                        y comunícate al <a href="tel:8343187200">(834) 318 7200</a>.
                    </p>
                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2 mt-4">
                        <a asp-page="/pago-en-linea" class="btn-primary">Intentar de nuevo</a>
                        <a href="/pago-en-linea" class="btn-secondary">Volver al pago</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm border-0">
                <div class="card-body p-5 text-center">
                    <div class="spinner-border text-danger mb-3" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Procesando pago...</span>
                    </div>
                    <h2 class="h4 mb-2">Procesando pago</h2>
                    <p class="text-muted mb-0">Estamos validando la transacción con la pasarela.</p>
                </div>
            </div>
        }
    </div>
</section>
