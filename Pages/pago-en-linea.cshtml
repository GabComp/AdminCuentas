@page "/pago-en-linea"
@model AdministradorDeCuentas.Pages.PagoReciboModel
@using Microsoft.Extensions.Configuration
@using System.Text.Json
@inject IConfiguration Configuration

@{
    Layout = "_Layout";
    ViewData["Title"] = "Pago en línea";
    ViewData["Description"] = "Consulta el adeudo de tu cuenta de agua potable en línea con tu número de cuenta.";

    var pagoHabilitado = Model.PagoHabilitado;
    var pagoMensaje = Model.MensajePago;
}

<style>
    .contenedor {
        position: relative;
        overflow: hidden;
    }

    /* Div que ya está visible */
    .div-visible {
        position: relative;
        z-index: 2;
    }

    /* Nuevo div */
    .fade-in {
        /* position: absolute; */
        /* top: 0; */
        /* left: 0; */
        /* width: 100%; */
        z-index: 1;
        animation: salirDeAtras 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes salirDeAtras {

        0% {
            opacity: 0;
            transform: translateX(-100%);
        }

        30% {
            opacity: 0.2;
        }

        50% {
            opacity: 0.5;
            /* transform: translateX(-35%); */
        }

        100% {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .fade-out {
        animation: fadeOutLeft 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes fadeOutLeft {
        0% {
            opacity: 1;
            transform: translateX(0);
        }

        30% {
            opacity: 0.5;
        }

        50% {
            opacity: 0.2;
        }

        100% {
            opacity: 0;
            transform: translateX(-100%);
        }
    }
</style>

<!-- Google Fonts: Montserrat y Open Sans para la identidad institucional -->
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">

@* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<!-- Se utiliza page-header para el título principal con fondo guinda institucional -->
<div class="page-header text-center">
    <div class="container">
        <h1>PAGO EN LÍNEA</h1>
        @* <p class="">
            Ingrese al sistema de Consultas y/o Pagos en Internet con más beneficios como consultar el Historial de Pagos, Factura Electrónica entre otros.
        </p>
        <a href="#" class="gob-link">Ir al Administrador de Cuentas</a> *@
    </div>
</div>

<div class="container content-section">
    <!-- Cambiado a row para permitir 2 columnas lado a lado -->
    <div class="row justify-content-center g-4">

        <!-- Tarjeta 1: Datos Generales -->
        <div class="col-md-6 col-lg-6" id="divCuenta">
            <div class="card shadow-sm border-0 mt-2">

                <!-- La clase bg-danger es sobreescrita en site.css para aplicar el color guinda -->
                <div class="card-header bg-danger text-white py-3">
                    <h2 class="h5 mb-0" style="font-family: var(--font-heading); font-weight: 600;">Datos generales</h2>
                </div>

                <div class="card-body p-4 bg-light">
                    <h3 class="visually-hidden">Formulario de consulta de adeudo</h3>
                    <div class="mb-3">
                        <label for="txtCuenta" class="form-label text-dark fw-bold">No de Cuenta:</label>
                        <input type="text"
                               id="txtCuenta"
                               class="form-control form-control-lg"
                               inputmode="numeric"
                               maxlength="6"
                               placeholder="Ej. 000026"
                               aria-describedby="cuentaHelp"
                               autocomplete="off" />
                        <div id="cuentaHelp" class="form-text">Ingresa solo números, sin guiones ni espacios (máximo 6 dígitos).</div>
                    </div>

                    <div class="mb-4">
                        <label for="txtNombre" class="form-label text-dark fw-bold">Nombre:</label>
                        <input type="text"
                               id="txtNombre"
                               class="form-control form-control-lg bg-white"
                               placeholder="Se mostrará al consultar la cuenta"
                               style="background: #E9ECEF !important;"
                               disabled />
                    </div>

                    <div class="d-grid mt-3">
                        <!-- btn-primary toma la tipografía Montserrat y los colores de site.css -->
                        <button type="button"
                                id="btnConsulta"
                                class="btn-primary border-0 w-100 d-flex justify-content-center align-items-center gap-2">
                            <span id="spinnerConsulta" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                            <span id="txtBtnConsulta">CONSULTA</span>
                            <i class="fas fa-search" id="iconoConsulta"></i>
                        </button>
                    </div>

                    <div id="msgConsulta" class="alert d-none mt-3 mb-0" role="status" aria-live="polite"></div>
                </div>

                @* <div class="card-footer bg-white border-0 text-center pb-4 pt-3">
                    <!-- callout-box le da un acento visual con el borde lateral guinda -->
                    <div class="callout-box d-flex justify-content-center mt-0 mb-4 py-3 px-4 shadow-sm">
                        <p class="mb-0 text-muted" style="font-size: 0.95rem;">
                            Presione el botón <strong>"Consulta"</strong> para ver su adeudo
                        </p>
                    </div>

                    <!-- gob-link aplica el color dorado institucional -->
                    <a asp-page="/Privacidad" class="text-decoration-none fw-semibold" style="color: var(--color-gob-guinda);">
                        Aviso de privacidad
                    </a>
                </div> *@

            </div>
        </div>

        <!-- Tarjeta 2: Saldo Pendiente (Oculta por defecto mediante 'd-none') -->
        <div class="col-md-6 col-lg-6 d-none fade-in" id="divSaldoPendiente">
            <div class="card shadow-sm border-0 mt-2">

                <div class="card-header bg-danger text-white py-3">
                    <h2 class="h5 mb-0" style="font-family: var(--font-heading); font-weight: 600;">Adeudo pendiente</h2>
                </div>

                <div class="card-body p-4 bg-light text-center">

                    <p class="text-muted mb-1">Titular de la cuenta</p>
                    <p id="txtTitular" class="h5 fw-bold text-dark mb-4">—</p>

                    <p class="text-muted mb-1">Total a pagar</p>
                    <h3 id="txtAdeudo" class="h2 fw-bold text-danger mb-3" style="font-family: var(--font-heading);">$0.00</h3>

                    <p id="txtEstadoAdeudo" class="text-muted mb-4"></p>

                    <div id="bloquePago" class="alert alert-info text-start mb-4" role="note">
                        @if (pagoHabilitado)
                        {
                            <i class="fas fa-lock me-1"></i>
                            <text>El cobro con tarjeta se realiza en la pasarela segura de EVO Payments.</text>
                        }
                        else
                        {
                            <i class="fas fa-clock me-1"></i>
                            <text>@pagoMensaje</text>
                        }
                    </div>

                    <hr class="my-4 text-muted opacity-25" />

                    <!-- Botones Pagar y Cancelar -->
                    <div class="row g-2">
                        <div class="col-6">
                            <button type="button"
                                    id="btnPagar"
                                    class="btn btn-secondary w-100 py-2 fw-bold d-flex justify-content-center align-items-center gap-2"
                                    disabled
                                    title="Consulta primero una cuenta con adeudo">
                                <span id="spinnerPagar" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                <i class="fas fa-lock" id="iconoPagar"></i>
                                <span id="textoPagar">Pagar</span>
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-danger w-100 py-2 fw-bold d-flex justify-content-center align-items-center gap-2" id="btnCancelar">
                                <i class="fas fa-times"></i> Cancelar
                            </button>
                        </div>
                    </div>
                </div>

                @* <div class="card-footer bg-white border-0 text-center pb-4 pt-3">
                    <p class="text-muted mb-0" style="font-size: 0.95rem;">
                        Consulta informativa del adeudo de agua potable
                    </p>
                </div> *@

            </div>
        </div>

    </div>
</div>

<!-- Modal de la pasarela EVO Payments -->
<div class="modal fade" id="modalPagoEvo" tabindex="-1" aria-labelledby="modalPagoEvoLabel" aria-hidden="true" style="z-index:1000000;">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="h5 modal-title" id="modalPagoEvoLabel">
                    <i class="fas fa-lock me-1"></i> Pago seguro
                </h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" style="min-height: 520px; overflow-y: auto;">
                <div id="evo-checkout-container"></div>
            </div>
            <div class="modal-footer">
                <small class="text-muted">
                    Los datos de tu tarjeta se capturan directamente en EVO Payments.
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.comapaPagoHabilitado = @(pagoHabilitado ? "true" : "false");
        window.comapaPagoMensaje = @Html.Raw(JsonSerializer.Serialize(pagoMensaje));
    </script>
    <script src="~/js/PagoEnLinea.js?v=@(DateTime.Now.Ticks)"></script>
}