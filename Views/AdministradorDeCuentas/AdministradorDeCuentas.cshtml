@{
    ViewBag.Title = "Administrar Cuenta";
}

@section Styles {
    <link href="~/css/AdministrarCuentas/AdministradorDeCuentas.css" asp-append-version="true" rel="stylesheet" />
}

<div class="mt-4">

    <h1 class="page-title">Administrar Cuenta</h1>

    <!-- BOTONES -->
    <div class="row mb-4">
        <div class="col-12">
            <!-- Limitamos el contenedor para que no abarquen toda la pantalla en monitores grandes -->
            <div class="row g-3 justify-content-center mx-auto" style="max-width: 600px;">

                <div class="col-12 col-md-6">
                    <!-- w-100 hace que el botón llene la columna -->
                    <button type="button" class="btn btn-principal btn-lg w-100" id="btnMostrarTabla" aria-pressed="true">
                        <i class="fas fa-table me-2"></i>
                        Mis Cuentas
                    </button>
                </div>

                <div class="col-12 col-md-6">
                    <button type="button" class="btn btn-outline-secondary btn-lg w-100" id="btnMostrarRegistro" aria-pressed="false">
                        <i class="fas fa-plus-circle me-2"></i>
                        Registrar Cuenta
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- TABLA -->
    <div id="contenedorTabla">

        <div class="card shadow-sm border-0 p-4">

            @* <h3 class="mb-4 text-center form-title">
                Administrar Mis Cuentas
            </h3> *@

            <div class="table-responsive">

                <table id="tablaCuentas" class="table table-bordered table-hover table-striped p-0" style="width:100%;">

                    <thead>
                        <tr>
                            <th>Cuenta</th>
                            <th>Alias</th>
                            <th>Editar</th>
                            <th>Eliminar</th>
                        </tr>
                    </thead>

                    <tbody>
                        <!-- DataTable -->
                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <!-- FORMULARIO -->
    <div id="contenedorRegistro" class="row justify-content-center align-items-stretch" style="display:none;">

        <div class="col-12 col-lg-6 mb-4 mb-lg-0">
            <div class="card card-form p-4">
                <h3 class="text-center form-title mb-4">Registro de Servicio</h3>

                <form asp-action="RegistrarServicio" method="post">

                    <!-- Numero de Servicio -->
                    <div class="mb-3">
                        <label for="txtNumeroServicio" class="form-label">Cuenta</label>
                        <input type="text" class="form-control" id="txtNumeroServicio" name="NumeroServicio"
                               inputmode="numeric"
                               oninput="this.value = this.value.replace(/[^0-9]/g, '')"
                               placeholder="Ej. 000026" required maxlength="6" />
                    </div>

                    <!-- Nombre Servicio -->
                    <div class="mb-3">
                        <label for="txtNombreServicio" class="form-label">Nombre del Propietario del Servicio</label>
                        <input type="text" class="form-control" id="txtNombreServicio" name="NombreServicio"
                               placeholder="Escríbelo como aparece en tu recibo" required />
                    </div>

                    <!-- Total a pagar -->
                    <div class="mb-3">
                        <label for="txtTotalPagar" class="form-label">Total a Pagar (del recibo más reciente)</label>
                        <input type="text" class="form-control" id="txtTotalPagar" name="TotalPagar"
                               inputmode="decimal"
                               oninput="this.value = this.value.replace(/[^0-9.]/g, '')"
                               placeholder="Ej. 1500.00" required />
                    </div>

                    <!-- Nombre corto -->
                    <div class="mb-4">
                        <label for="txtNombreCorto" class="form-label">Nombre Corto (Alias)</label>
                        <input type="text" class="form-control" id="txtNombreCorto" name="NombreCorto"
                               placeholder="Ej. Casa" required maxlength="20" />
                    </div>

                    <!-- CÓDIGO DE VERIFICACIÓN -->
                    <div class="mb-3 d-none" id="grupoCodigoVinculacion">
                        <label for="txtCodigoVinculacion" class="form-label">Código de verificación</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-shield-halved"></i></span>
                            <input type="text" class="form-control" id="txtCodigoVinculacion"
                                   placeholder="6 dígitos" maxlength="6" inputmode="numeric"
                                   autocomplete="one-time-code">
                        </div>
                        <div class="form-text">
                            Enviamos un código a tu correo.
                            <a href="#" id="btnReenviarCodigoVinculacion" class="text-decoration-none">Reenviar</a>
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="button" class="btn btn-principal btn-lg" id="btnRegistrarServicio">
                            Registrar
                        </button>
                    </div>

                </form>
            </div>
        </div>

        <!-- IMAGEN -->
        <div class="col-12 col-lg-6 d-flex" id="divRecibo">
            <div class="card card-form w-100 p-3 d-flex">
                <div class="zoom-container">
                    <img src="~/img/reciboIndicaciones.png"
                         class="img-fluid imagen-recibo"
                         id="imgZoom"
                         alt="Servicio" />
                </div>
            </div>
        </div>

    </div>


</div>

