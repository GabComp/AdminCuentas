@{
    ViewBag.Title = "Registro de Servicio";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
<link href="~/css/AdministrarCuentas/AdministradorDeCuentas.css" rel="stylesheet" />

<div class="container mt-5">

    <!-- BOTONES -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-wrap gap-3 justify-content-center">

                <button class="btn btn-principal btn-lg px-4"
                        id="btnMostrarTabla">
                    <i class="fas fa-table me-2"></i>
                    Administrar Mis Cuentas
                </button>

                <button class="btn btn-outline-secondary btn-lg px-4"
                        id="btnMostrarRegistro">
                    <i class="fas fa-plus-circle me-2"></i>
                    Registrar Cuenta
                </button>

            </div>
        </div>
    </div>

    <!-- TABLA -->
    <div id="contenedorTabla">

        <div class="card shadow-sm border-0 p-4">

            @* <h3 class="mb-4 text-center form-title">
                Administrar Mis Cuentas
            </h3> *@

            <div class="table-responsive">

                <table id="tablaCuentas" class="table table-bordered table-hover table-striped p-0" style="width:100%;">

                    <thead>
                        <tr>
                            <th>Cuenta</th>
                            <th>Alias</th>
                            @* <th>Total</th>
                            <th>Nombre Corto</th> *@
                            @* <th>Editar</th> *@
                            <th>Eliminar</th>
                        </tr>
                    </thead>

                    <tbody>
                        <!-- DataTable -->
                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <!-- FORMULARIO -->
    <div id="contenedorRegistro" class="row justify-content-center align-items-stretch" style="display:none;">

        <div class="col-12 col-lg-6 mb-4 mb-lg-0">
            <div class="card card-form p-4">
                <h3 class="text-center form-title mb-4">Registro de Servicio</h3>

                <form asp-action="RegistrarServicio" method="post">

                    <!-- Numero de Servicio -->
                    <div class="mb-3">
                        <label for="txtNumeroServicio" class="form-label">Cuenta</label>
                        <input type="text" class="form-control" id="txtNumeroServicio" name="NumeroServicio"
                               oninput="this.value = this.value.replace(/[^0-9]/g, '')"
                               placeholder="" required maxlength="100" />
                    </div>

                    <!-- Nombre Servicio -->
                    <div class="mb-3">
                        <label for="txtNombreServicio" class="form-label">Nombre del Propietario del Servicio</label>
                        <input type="text" class="form-control" id="txtNombreServicio" name="NombreServicio"
                               placeholder="escriba el nombre como aparece en su recibo" required />
                    </div>

                    <!-- Total a pagar -->
                    <div class="mb-3">
                        <label for="txtTotalPagar" class="form-label">Total a Pagar (del recibo mas reciente)</label>
                        <input type="text" class="form-control" id="txtTotalPagar" name="TotalPagar"
                               oninput="this.value = this.value.replace(/[^0-9]/g, '')"
                               placeholder="Ej. 1500" required />
                    </div>

                    <!-- Nombre corto -->
                    <div class="mb-4">
                        <label for="txtNombreCorto" class="form-label">Nombre Corto (Alias)</label>
                        <input type="text" class="form-control" id="txtNombreCorto" name="NombreCorto"
                               placeholder="Ej. Consuelo Casa" required required maxlength="20" />
                    </div>

                    <div class="d-grid">
                        <button type="button" class="btn btn-principal btn-lg" id="btnRegistrarServicio">
                            Registrar
                        </button>
                    </div>

                </form>
            </div>
        </div>

        <!-- IMAGEN -->
        <div class="col-12 col-lg-6 d-flex" id="divRecibo">
            <div class="card card-form w-100 p-3 d-flex">
                <div class="zoom-container">
                    <img src="~/img/reciboIndicaciones.png"
                         class="img-fluid imagen-recibo"
                         id="imgZoom"
                         alt="Servicio" />
                </div>
            </div>
        </div>

    </div>


</div>

