@{
    ViewData["Title"] = "Constancia de no Adeudo";
}

@section Styles {
    <link href="~/css/Recibos/RecibosUsuario.css" asp-append-version="true" rel="stylesheet" />
    <style>
        .requisitos-list {
            padding-left: 1.1rem;
            margin-bottom: 0;
        }

        .requisitos-list li {
            margin-bottom: 0.55rem;
            color: #4a5568;
        }

        .costo-tramite {
            display: inline-block;
            margin-top: 10px;
            padding: 6px 12px;
            border-radius: 999px;
            background-color: var(--color-gob-dorado-light, #F7F3EC);
            color: var(--color-gob-guinda, #691C32);
            font-weight: 600;
        }
    </style>
}

<header class="header">
    <div>
        <h1>Constancia de no Adeudo</h1>
        <p>Revisa los requisitos y descarga los términos del trámite.</p>
    </div>
</header>

<main>
    <div class="row align-items-end gy-3 justify-content-between mb-2">
        <div class="col-12 col-md-5">
            <label for="SelectCuentaHojaAdeudo" class="form-label">Selecciona una cuenta:</label>
            <select id="SelectCuentaHojaAdeudo" class="form-select">
                <option value="0">Selecciona un número de cuenta</option>
            </select>
        </div>

        <div class="col-12 col-md-auto gap-2 justify-content-center justify-content-md-end d-none" id="divButtonDownload">
            <button type="button" class="btn btn-download" id="BtnDownload" aria-label="Descargar términos y condiciones del trámite">
                <i class="fas fa-file-download"></i>
                <span>Descargar términos</span>
            </button>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-12 col-lg-7">
            <div class="documents-section h-100">
                <h2 class="section-title">Requisitos</h2>
                <ul class="requisitos-list">
                    <li>Estar al corriente con sus pagos, sin traslado de saldo.</li>
                    <li>Copia de identificación oficial del propietario.</li>
                    <li>Si el contrato no está a su nombre, acreditar la propiedad (escrituras o sentencia).</li>
                    <li>Si otra persona realiza el trámite, deberá presentar identificación oficial y carta poder simple.</li>
                    <li>Formato de solicitud lleno, para notario o a quien corresponda.</li>
                    <li>La toma deberá contar con medidor en buen funcionamiento.</li>
                </ul>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="documents-section h-100">
                <h2 class="section-title">Antes de iniciar</h2>
                <p class="text-muted mb-2">
                    Selecciona la cuenta vinculada para habilitar la descarga de los términos y condiciones.
                    El trámite se concluye en la sucursal.
                </p>
                <span class="costo-tramite">Costo del trámite: $204.00</span>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/HojaAdeudo/HojaAdeudo.js?v=@(DateTime.Now.Ticks)"></script>
}
