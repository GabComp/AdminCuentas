@{
    ViewBag.Title = "Actualizar Datos";
    // Layout = null; // Descomenta si no usas layout general
}
@* <link href="~/css/Login/Login.css" rel="stylesheet" /> *@
<link href="~/css/Login/ActualizarDatos.css" rel="stylesheet" />

<div class="update-wrapper">
    <div class="login-container">

        <div class="login-header">
            @* <div class="logo-placeholder mb-3 mx-auto" style="width: 60px; height: 60px;">
                <img src="~/Resources/Images/MiNominaDigital/logoComapa.jpg" alt="Logo Empresa" style="width: 100%; height: 100%; object-fit: contain; border-radius: 50%;">
            </div> *@
            <h2>Actualizar Datos</h2>
        </div>

        <div class="login-body">
            <form id="loginForm">

                <div class="mb-3">
                    <label for="TxtUserUpdate" class="form-label">Usuario:</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-user"></i>
                        </span>
                        <input type="text" class="form-control" id="TxtUserUpdate" placeholder="Nombre de usuario (sin espacios)" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="TxtMailUpdate" class="form-label">Correo electrónico:</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-envelope"></i>
                        </span>
                        <input type="email" class="form-control" id="TxtMailUpdate" placeholder="ejemplo@correo.com" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="TxtMailConfirmUpdate" class="form-label">Confirmar correo electrónico:</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-envelope"></i>
                        </span>
                        <input type="email" class="form-control" id="TxtMailConfirmUpdate" placeholder="ejemplo@correo.com" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="TxtPassUpdate" class="form-label">Contraseña:</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-lock"></i>
                        </span>
                        <input type="password" class="form-control" id="TxtPassUpdate" placeholder="Mínimo 8 caracteres, un número y una letra" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="TxtPassConfrimUpdate" class="form-label">Confirmar contraseña:</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-lock"></i>
                        </span>
                        <input type="password" class="form-control" id="TxtPassConfrimUpdate" placeholder="Repite tu contraseña" required>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="TxtNewTelUpdate" class="form-label">Teléfono:</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-mobile-alt"></i>
                        </span>
                        <input type="tel" class="form-control" id="TxtNewTelUpdate" placeholder="10 dígitos (solo números)" pattern="[0-9]*" maxlength="10" required>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-login text-white" id="btnUpdate">
                        <i class="fas fa-user-edit me-2"></i>Actualizar Datos
                    </button>
                    <button type="button" class="btn text-secondary mt-1" id="btnLogOut">
                        <i class="fas fa-sign-out-alt me-2"></i>Cerrar sesión
                    </button>
                </div>

            </form>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/Login/ActualizarDatos.js?v=@(DateTime.Now.Ticks)"></script>
}