@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="~/css/Login/Login.css" rel="stylesheet" />
</head>
<body>
    <div class=" mt-5">
        <div class="login-container">
            <div class="login-header">
                @* <div class="logo-placeholder">
                    <img src="~/Resources/Images/MiNominaDigital/logoComapa.jpg" alt="Logo Empresa" style="width: 100%; height: 100%; object-fit: contain; border-radius: 50%;">
                </div> *@
                <h2 style="color:white">Actualizar Datos</h2>
            </div>
            <div class="login-body">
                @* <h3 class="text-center mb-4" style="color: #333;">Iniciar Sesión</h3> *@
                <form id="loginForm">
                    <div class="mb-3">
                        <label for="TxtUserUpdate" class="form-label" style="color: #555; font-weight: 500;">usuario:</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-user" style="color: #666;"></i>
                            </span>
                            <input type="text" class="form-control" id="TxtUserUpdate" placeholder="Nombre de Usuario (No debe tener espacios)" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="TxtMailUpdate" class="form-label" style="color: #555; font-weight: 500;">Correo:</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-envelope" style="color: #666;"></i>
                            </span>
                            <input type="email" class="form-control" id="TxtMailUpdate" placeholder="ejemplo@gmail.com" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="TxtMailConfirmUpdate" class="form-label" style="color: #555; font-weight: 500;">Confirmar correo:</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-envelope" style="color: #666;"></i>
                            </span>
                            <input type="email" class="form-control" id="TxtMailConfirmUpdate" placeholder="ejemplo@gmail.com" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="TxtPassUpdate" class="form-label" style="color: #555; font-weight: 500;">Contraseña:</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-lock" style="color: #666;"></i>
                            </span>
                            <input type="password" class="form-control" id="TxtPassUpdate" placeholder="debe contener 8 caracteres minimo un numero y una letra" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="TxtPassConfrimUpdate" class="form-label" style="color: #555; font-weight: 500;">Contraseña:</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-lock" style="color: #666;"></i>
                            </span>
                            <input type="password" class="form-control" id="TxtPassConfrimUpdate" placeholder="debe contener 8 caracteres minimo un numero y una letra" required>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="TxtNewTelUpdate" class="form-label" style="color: #555; font-weight: 500;">Telefono</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-mobile-alt" style="color: #666;"></i>
                            </span>
                            <input type="tel" class="form-control" id="TxtNewTelUpdate" placeholder="10 CARACTRERES (Solo Numeros)" pattern="[0-9]*" required>
                        </div>
                    </div>


                    <button type="button" class="btn btn-login w-100 text-white" id="btnUpdate">
                        <i class="fas fa-user-edit me-2"></i>Actualizar
                    </button>
                    <button type="button" class="btn btn-login w-100 text-white mt-2" id="btnLogOut">
                        <i class="fas fa-sign-out-alt me-2"></i>cerrar sesion
                    </button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
@section Scripts {
    <script src="~/js/Login/ActualizarDatos.js?v=@(DateTime.Now.Ticks)"></script>
}