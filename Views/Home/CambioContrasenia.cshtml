@{
    ViewData["Title"] = "Cambiar contraseña";
}

@section Styles {
    <link href="~/css/Login/Registro.css" asp-append-version="true" rel="stylesheet" />
}

<div class="register-page">
    <div class="register-wrapper">
        <div class="login-container">

            <div class="login-header">
                <div class="security-icon">
                    <i class="fas fa-unlock-keyhole"></i>
                </div>
                <h1>Cambia tu Contraseña</h1>
                <p>Ingresa el código que enviamos a tu correo y define una nueva contraseña.</p>
            </div>

            <div class="login-body">
                <form autocomplete="off" id="loginForm">

                    <div class="mb-3">
                        <label for="TxtCodigo" class="form-label">Código</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-key"></i></span>
                            <input type="text" class="form-control" id="TxtCodigo"
                                   placeholder="Ingresa el código del correo"
                                   autocomplete="one-time-code" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="TxtPassChange" class="form-label">Nueva Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-lock"></i></span>
                            <input type="password" class="form-control" id="TxtPassChange"
                                   placeholder="Mínimo 8 caracteres, un número y una letra"
                                   autocomplete="new-password" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="TxtPassChangeConfrim" class="form-label">Confirmar Nueva Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-lock"></i></span>
                            <input type="password" class="form-control" id="TxtPassChangeConfrim"
                                   placeholder="Repite la nueva contraseña"
                                   autocomplete="new-password" required>
                        </div>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="button" class="btn btn-login" id="btnUpdateContra">
                            <i class="fas fa-unlock-alt me-2"></i>Confirmar Cambio
                        </button>
                    </div>

                </form>
            </div>

            <div class="security-footer">
                <i class="fas fa-lock me-1"></i>
                Tu información se mantiene protegida.
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Login/CambioContrasenia.js?v=@(DateTime.Now.Ticks)"></script>
}
