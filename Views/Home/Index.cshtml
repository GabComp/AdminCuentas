@{
    ViewData["Title"] = "Login Servicio";
    Layout = null;
}

<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="~/css/Login/Login.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-5">
        <div class="login-container">
            <div class="login-header">
                @* <div class="logo-placeholder">
                    <img src="~/Resources/Images/MiNominaDigital/logoComapa.jpg" alt="Logo Empresa" style="width: 100%; height: 100%; object-fit: contain; border-radius: 50%;">
                </div> *@
                <h2 style="color:white">Iniciar sesion</h2>
            </div>
            <div class="login-body">
                @* <h3 class="text-center mb-4" style="color: #333;">Iniciar Sesión</h3> *@
                <form id="loginForm">
                    <div class="mb-3">
                        <label for="TxtCorreo" class="form-label" style="font-weight: 500;">Usuario:</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-user" style="color: #666;"></i></span>
                            <input type="text" class="form-control" id="TxtUser" placeholder="nombre de usuario o correo" required>
                        </div>
                    </div>

                    @* <div class="mb-3">
                        <label for="TxtCorreolog" class="form-label" style="color: #555; font-weight: 500;">Correo:</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-user" style="color: #666;"></i></span>
                            <input type="text" class="form-control" id="TxtCorreolog" placeholder="ejemplo@gmail.com" required>
                        </div>
                    </div> *@

                    <div class="mb-3">
                        <label for="TxtPass" class="form-label" style="font-weight: 500;">Contraseña:</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-lock" style="color: #666;"></i></span>
                            <input type="password" name="password" class="form-control" autocomplete="current-password" id="TxtPass" 
                                    placeholder="debe contener 8 caracteres minimo un numero y una letra" required>
                        </div>
                    </div>

                    <div class="mb-4 mt-4" style="display: felx; text-align: center;">
                        <label class="form-check-label align-content-center" for="chkTerminos">
                            ¿No tienes una cuenta?
                            <a href="~/Home/Registro"
                               id="lnkTerminos"
                               class="text-primary text-decoration-underline">
                                Registrate aqui
                            </a>
                        </label>
                    </div>

                    <div class="mb-4 mt-4" style="display: felx; text-align: center;">
                        <label class="form-check-label align-content-center" for="chkTerminos">
                            ¿olvidaste tu contraseña?
                            <a href="~/Home/RestableceContra"
                               id="lnkTerminos"
                               class="text-primary text-decoration-underline">
                                Haz click aqui
                            </a>
                        </label>
                    </div>

                    <div class="LoginButtons">
                        <button type="button" class="btn btn-login w-100 text-white" id="btnOmitir">
                            <i class="fas fa-times-circle me-2"></i> Continuar sin usuario
                        </button>
                        <button type="button" class="btn btn-login w-100 text-white" id="btnIniciarSession">
                            <i class="fas fa-sign-in-alt me-2"></i>Entrar
                        </button>
                        @* <button type="button" class="btn btn-login w-100 text-white" id="btnRegistrarse">
                            <i class="fas fa-id-card me-2"></i>Registrarse
                        </button> *@
                    </div>

                </form>
            </div>
        </div>
    </div>
</body>
</html>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/Login/LoginServcios.js?v=@(DateTime.Now.Ticks)"></script>