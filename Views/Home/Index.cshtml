@{
    ViewData["Title"] = "Login Servicio";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="~/css/Login/Login.css" rel="stylesheet" />
</head>
<body>
    <main class="login-layout">
        
        <!-- Área Visual Institucional -->
        <section class="login-visual">
            <div class="visual-content">
                <div class="brand-logo-placeholder mb-4">
                    <i class="fas fa-landmark"></i>
                </div>
                <h1 class="visual-title">Sistema Institucional</h1>
                <p class="visual-subtitle">Plataforma segura y eficiente para la gestión de servicios.</p>
            </div>
            <div class="visual-pattern"></div>
        </section>

        <!-- Área de Autenticación -->
        <section class="login-form-section">
            <div class="form-wrapper">
                
                <div class="form-header mb-4">
                    <h2>Iniciar sesión</h2>
                    <p class="text-muted">Ingresa tus credenciales institucionales</p>
                </div>

                <form id="loginForm" novalidate>
                    
                    <div class="mb-4">
                        <label for="TxtUser" class="form-label fw-semibold">Usuario o Correo</label>
                        <div class="input-group modern-input-group">
                            <span class="input-group-text"><i class="fas fa-user"></i></span>
                            <input type="text" class="form-control" id="TxtUser" placeholder="nombre de usuario o correo" autocomplete="username" required>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="TxtPass" class="form-label fw-semibold mb-0">Contraseña</label>
                        </div>
                        <div class="input-group modern-input-group">
                            <span class="input-group-text"><i class="fas fa-lock"></i></span>
                            <input type="password" name="password" class="form-control" autocomplete="current-password" id="TxtPass" placeholder="debe contener 8 caracteres minimo un numero y una letra" required>
                            <button class="btn btn-outline-secondary toggle-password" type="button" aria-label="Mostrar contraseña">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <div class="text-end mt-2">
                             <a href="~/Home/RestableceContra" class="forgot-link text-decoration-none">¿Olvidaste tu contraseña?</a>
                        </div>
                    </div>

                    <div class="mt-5 mb-4 LoginButtons">
                        <button type="button" class="btn btn-login w-100 d-flex justify-content-center align-items-center" id="btnIniciarSession">
                            <span class="btn-text">Entrar</span>
                            <i class="fas fa-sign-in-alt ms-2 btn-icon"></i>
                        </button>
                    </div>

                    <div class="text-center mt-4 pt-3 border-top register-section">
                        <span class="text-muted">¿No tienes una cuenta?</span>
                        <a href="~/Home/Registro" id="lnkTerminos" class="register-link fw-semibold ms-1 text-decoration-none">Regístrate aquí</a>
                    </div>
                </form>

            </div>
        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- Script para funcionalidad visual de contraseña -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const togglePasswordBtn = document.querySelector('.toggle-password');
            const passwordInput = document.getElementById('TxtPass');
            if (togglePasswordBtn && passwordInput) {
                togglePasswordBtn.addEventListener('click', function() {
                    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                    passwordInput.setAttribute('type', type);
                    const icon = this.querySelector('i');
                    icon.classList.toggle('fa-eye');
                    icon.classList.toggle('fa-eye-slash');
                });
            }
        });
    </script>
    
    <script src="~/js/Login/LoginServcios.js?v=@(DateTime.Now.Ticks)"></script>
</body>
</html>