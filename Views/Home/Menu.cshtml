@{
    ViewBag.Title = "Menú Principal";
    // Layout = null; // quítalo si ya usas Layout
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Menú Principal</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', sans-serif;
        }

        body {
            background: #f5f5f5;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            /* justify-content: center;
            align-items: center; */
            
        }

        .menu-container {
            width: 100%;
            max-width: 1200px;
        }

        .menu-title {
            text-align: center;
            margin-bottom: 40px;
            color: #AB0033;
            font-size: 2.5rem;
            font-weight: bold;
        }

        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 25px;
        }

        .menu-card {
            background: #AB0033;
            color: white;
            text-decoration: none;
            border-radius: 20px;
            padding: 40px 25px;
            min-height: 220px;

            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;

            transition: all 0.25s ease;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        }

        .menu-card:hover {
            transform: scale(1.05);
            background: #c1003b;
            box-shadow: 0 12px 28px rgba(0,0,0,0.22);
        }

        .menu-card i {
            font-size: 4rem;
            margin-bottom: 20px;
        }

        .menu-card span {
            font-size: 1.3rem;
            font-weight: 600;
            text-align: center;
        }

        @@media(max-width: 768px) {
            .menu-title {
                font-size: 2rem;
            }

            .menu-card {
                min-height: 180px;
                padding: 30px 20px;
            }

            .menu-card i {
                font-size: 3rem;
            }

            .menu-card span {
                font-size: 1.1rem;
            }
        }
    </style>
</head>
<body>

    <div class="menu-container">

        <h1 class="menu-title p-5">Selecciona una opcion</h1>

        <div class="menu-grid">

           @*  <a href="@Url.Action("RegistrarCuenta", "Cuenta")" class="menu-card">
                <i class="fas fa-user-plus"></i>
                <span>Registrar Cuenta</span>
            </a> *@

            <a href="@Url.Action("AdministradorDeCuentas", "AdministradorDeCuentas")" class="menu-card">
                <i class="fas fa-users-cog"></i>
                <span>Administrar Cuenta</span>
            </a>

            <a href="@Url.Action("Recibos", "Recibos")" class="menu-card">
                <i class="fas fa-file-invoice-dollar"></i>
                <span>Consultar Recibos</span>
            </a>

            <a href="@Url.Action("PagoLinea", "PagoLinea")" class="menu-card">
                <i class="fas fa-credit-card"></i>
                <span>Pagar</span>
            </a>

        </div>

    </div>

</body>
</html>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="~/js/AdminCuentas/AdministradorDeCuentas.js?v=@(DateTime.Now.Ticks)"></script>
}