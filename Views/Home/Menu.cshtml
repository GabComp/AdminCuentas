@{
    ViewBag.Title = "Menú Principal";
    // El Layout se asigna automáticamente por el _ViewStart.cshtml
}

@section Styles {
    <link href="~/css/menuprincipal.css" asp-append-version="true" rel="stylesheet" />
}

<div class="menu-container">

    <h1 class="menu-title">Selecciona una opción</h1>
    <p class="menu-subtitle">Gestiona tus servicios de agua potable de forma rápida y segura.</p>

    <div class="menu-grid">

        <a href="/pago-en-linea" class="menu-card">
            <div class="icon-wrapper">
                <i class="fas fa-credit-card"></i>
            </div>
            <span class="menu-card-title">Pagar</span>
            <small class="menu-card-desc">Consulta y paga tu adeudo en línea</small>
        </a>

        <a href="@Url.Action("AdministradorDeCuentas", "AdministradorDeCuentas")" class="menu-card">
            <div class="icon-wrapper">
                <i class="fas fa-users-cog"></i>
            </div>
            <span class="menu-card-title">Administrar Cuenta</span>
            <small class="menu-card-desc">Vincula o elimina tus cuentas</small>
        </a>

        <a href="@Url.Action("Recibos", "Recibos")" class="menu-card">
            <div class="icon-wrapper">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <span class="menu-card-title">Consultar Recibos</span>
            <small class="menu-card-desc">Descarga tus recibos en PDF</small>
        </a>

        <a href="@Url.Action("HojaAdeudo", "HojaAdeudo")" class="menu-card">
            <div class="icon-wrapper">
                <i class="fas fa-file-circle-check"></i>
            </div>
            <span class="menu-card-title">Hoja de no adeudo</span>
            <small class="menu-card-desc">Consulta los requisitos del trámite</small>
        </a>

    </div>

</div>
