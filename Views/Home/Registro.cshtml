@{
    ViewData["Title"] = "Registrar usuario";
}

@section Styles {
    <link href="~/css/Login/Registro.css" asp-append-version="true" rel="stylesheet" />
}

<div class="register-page">
    <div class="register-wrapper">
        <div class="login-container">

            <div class="login-header">
                <div class="security-icon">
                    <i class="fas fa-user-plus"></i>
                </div>
                <h1>Registrar Nuevo Usuario</h1>
                <p>Completa los datos para crear tu cuenta de usuario.</p>
            </div>

            <div class="login-body">
                <form autocomplete="off" id="loginForm">

                    <div class="mb-3">
                        <label for="TxtNewUser" class="form-label">Usuario</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-user"></i></span>
                            <input type="text" class="form-control" id="TxtNewUser"
                                   placeholder="Nombre de usuario (sin espacios)" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="TxtPassW" class="form-label">Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-lock"></i></span>
                            <input type="password" class="form-control" id="TxtPassW"
                                   placeholder="Mínimo 8 caracteres, un número y una letra"
                                   autocomplete="new-password" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="TxtPassWConfrim" class="form-label">Confirmar Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-lock"></i></span>
                            <input type="password" class="form-control" id="TxtPassWConfrim"
                                   placeholder="Confirma tu contraseña"
                                   autocomplete="new-password" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="TxtMail" class="form-label">Correo electrónico</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                            <input type="email" class="form-control" id="TxtMail"
                                   placeholder="ejemplo@gmail.com" autocomplete="email" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="TxtMailConfirm" class="form-label">Confirmar correo electrónico</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                            <input type="email" class="form-control" id="TxtMailConfirm"
                                   placeholder="Confirma tu correo" autocomplete="email" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="TxtNewTel" class="form-label">Teléfono celular</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-mobile-alt"></i></span>
                            <input type="tel" class="form-control" id="TxtNewTel"
                                   placeholder="10 caracteres (solo números)"
                                   pattern="[0-9]*" maxlength="10"
                                   inputmode="numeric" autocomplete="tel" required />
                        </div>
                    </div>

                    <div class="terms-container">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="chkTerminos" />
                            <label class="form-check-label" for="chkTerminos">
                                Acepto los
                                <a asp-controller="Home" asp-action="Privacy" id="lnkTerminos" target="_blank">
                                    Términos y Condiciones
                                </a>
                            </label>
                        </div>
                    </div>

                    <span id="msgTerminos" class="terms-error d-none">
                        Debes abrir y aceptar los Términos y Condiciones
                    </span>

                    <div class="mb-3 d-none" id="grupoCodigoRegistro">
                        <label for="TxtCodigoRegistro" class="form-label">Código de verificación</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-shield-halved"></i></span>
                            <input type="text" class="form-control" id="TxtCodigoRegistro"
                                   placeholder="6 dígitos" maxlength="6" inputmode="numeric"
                                   autocomplete="one-time-code">
                        </div>
                        <div class="form-text">
                            Enviamos un código a tu correo.
                            <a href="#" id="btnReenviarCodigo" class="text-decoration-none">Reenviar</a>
                        </div>
                    </div>

                    <div class="LoginButtons">
                        <button type="button" class="btn btn-login" id="btnRegistrar">
                            <i class="fas fa-user-plus me-2"></i>
                            Registrarse
                        </button>
                        <button type="button" class="btn btn-back" id="btnBackIndex2">
                            <i class="fas fa-undo me-2"></i>
                            Regresar
                        </button>
                    </div>

                </form>
            </div>

            <div class="security-footer">
                <i class="fas fa-shield-alt me-1"></i>
                Tu información se mantiene protegida.
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Login/Registrarse.js?v=@(DateTime.Now.Ticks)"></script>
}
