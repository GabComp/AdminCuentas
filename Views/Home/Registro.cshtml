@* @{
    ViewData["Title"] = "Login Servicio";
} *@

<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="~/css/Login/Registro.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-3 " style="margin-bottom: 120px;">
        <div class="login-container">
            <div class="login-header">
                <h2 style="color:white">Registrar Nuevo Usuario</h2>
            </div>
            <div class="login-body">
                @* <h3 class="text-center mb-4" style="color: #333;">Iniciar Sesión</h3> *@
                <form autocomplete="off" id="loginForm">
                    <div class="mb-3">
                        <label for="TxtCorreo" class="form-label" style="font-weight: 500;">Usuario:</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-user" style="color: #666;"></i>
                            </span>
                            <input type="text" class="form-control" id="TxtNewUser" placeholder="Nombre de Usuario" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="TxtPassW" class="form-label" style="font-weight: 500;">Contraseña:</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-lock" style="color: #666;"></i>
                            </span>
                            <input type="password" class="form-control" id="TxtPassW" placeholder="debe contener 8 caracteres minimo un numero y una letra" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="TxtPassWConfrim" class="form-label" style="font-weight: 500;">Contraseña:</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-lock" style="color: #666;"></i>
                            </span>
                            <input type="password" class="form-control" id="TxtPassWConfrim" placeholder="debe contener 8 caracteres minimo un numero y una letra" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="TxtCorreo" class="form-label" style="font-weight: 500;">Correo:</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-envelope" style="color: #666;"></i>
                            </span>
                            <input type="email" class="form-control" id="TxtMail" placeholder="ejemplo@gmail.com" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="TxtCorreo" class="form-label" style="font-weight: 500;">Confirmar correo:</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-envelope" style="color: #666;"></i>
                            </span>
                            <input type="email" class="form-control" id="TxtMailConfirm" placeholder="ejemplo@gmail.com" required>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="TxtTel" class="form-label" style="font-weight: 500;">Telefono Celular</label>
                        <div class="input-group">
                            <span class="input-group-text"> 
                                <i class="fas fa-mobile-alt" style="color: #666;"></i>
                            </span>
                            <input type="tel" class="form-control" id="TxtNewTel" placeholder="10 CARACTRERES (Solo Numeros)" pattern="[0-9]*" required>
                        </div>
                    </div>

                    <div class="form-group form-check mt-3 mb-3">
                        <input type="checkbox"
                               class="form-check-input"
                               id="chkTerminos"
                               disabled />

                        <label class="form-check-label" for="chkTerminos">
                            Acepto los
                            <a href="~/docs/TerminosYCondiciones.pdf"
                               target="_blank"
                               id="lnkTerminos"
                               class="text-primary text-decoration-underline">
                                Términos y Condiciones
                            </a>
                        </label>
                    </div>

                    <span id="msgTerminos" class="text-danger d-none">
                        Debes abrir y aceptar los Términos y Condiciones
                    </span>


                    <button type="button" class="btn btn-login w-100 text-white" id="btnRegistrar">
                        <i class="fas fa-user-plus me-2"></i>registrarse
                    </button>
                    
                    <button type="button" class="btn btn-login w-100 text-white mt-3 mb-3" id="btnBackIndex2">
                        <i class="fas fa-undo me-2"></i>Regresar
                    </button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
@section Scripts {
    <script src="~/js/Login/Registrarse.js?v=@(DateTime.Now.Ticks)"></script>
}