@* @{
    ViewData["Title"] = "Login Servicio";
} *@

<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="~/css/Login/Login.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-5">
        <div class="login-container">
            <div class="login-header">
                @* <div class="logo-placeholder">
                    <img src="~/Resources/Images/MiNominaDigital/logoComapa.jpg" alt="Logo Empresa" style="width: 100%; height: 100%; object-fit: contain; border-radius: 50%;">
                </div> *@
                <h3 style="color:white">Confirme su correo para enviarle un codigo para poder reestablecer su contraseña</h3>
            </div>
            <div class="login-body">
                @* <h3 class="text-center mb-4" style="color: #333;">Iniciar Sesión</h3> *@
                <form id="loginForm">
                    <div class="mb-3">
                        <label for="TxtCorreo" class="form-label" style="color: #555; font-weight: 500;">Correo:</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-envelope" style="color: #666;"></i>
                            </span>
                            <input type="email" class="form-control" id="TxtMailContra" placeholder="ejemplo@gmail.com" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="TxtCorreo" class="form-label" style="color: #555; font-weight: 500;">Confirmar correo:</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-envelope" style="color: #666;"></i>
                            </span>
                            <input type="email" class="form-control" id="TxtMailContraConfirm" placeholder="ejemplo@gmail.com" required>
                        </div>
                    </div>

                    <div class="form-check mt-3 mb-4" >
                        <input class="form-check-input" type="checkbox" name="name" id="chkNoRobot" />
                        <label class="form-check-label" for="chkNoRobot">
                            No soy un robot
                        </label>
                    </div>
                    <span id="robotError" class="text-danger d-none">
                        Debes confirmar que no eres un robot
                    </span>

                    <div class="LoginButtons">
                        <button type="button" class="btn btn-login w-100 text-white" id="btnBackIndex">
                            <i class="fas fa-undo me-2"></i>Regresar
                        </button>
                        <button type="button" class="btn btn-login w-100 text-white" id="btnContinuarContra">
                            <i class="fas fa-arrow-right me-2"></i>Continuar 
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</body>
</html>
@section Scripts {
    <script src="~/js/Login/restablecerContrasenia.js?v=@(DateTime.Now.Ticks)"></script>
}