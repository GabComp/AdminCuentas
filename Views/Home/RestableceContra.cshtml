@{
    ViewData["Title"] = "Restablecer contraseña";
}

@section Styles {
    <link href="~/css/Login/RestablecerContrasneia.css" asp-append-version="true" rel="stylesheet" />
}

<div class="update-page">
    <div class="update-wrapper">
        <div class="login-container">

            <div class="login-header">
                <div class="security-icon">
                    <i class="fas fa-key"></i>
                </div>
                <h1>Restablecer Contraseña</h1>
                <p>Confirma tu correo electrónico para recibir un código de recuperación.</p>
            </div>

            <div class="login-body">
                <form id="loginForm" autocomplete="off">

                    <div class="mb-4">
                        <label for="TxtMailContra" class="form-label">Correo electrónico</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                            <input type="email" class="form-control" id="TxtMailContra"
                                   placeholder="ejemplo@correo.com" autocomplete="email" required>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="TxtMailContraConfirm" class="form-label">Confirmar correo electrónico</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                            <input type="email" class="form-control" id="TxtMailContraConfirm"
                                   placeholder="Repite tu correo electrónico" autocomplete="email" required>
                        </div>
                    </div>

                    <div class="LoginButtons">
                        <button type="button" class="btn btn-back" id="btnBackIndex">
                            <i class="fas fa-arrow-left me-2"></i>
                            Regresar
                        </button>
                        <button type="button" class="btn btn-login" id="btnContinuarContra">
                            Continuar
                            <i class="fas fa-arrow-right ms-2"></i>
                        </button>
                    </div>

                </form>
            </div>

            <div class="security-footer">
                <i class="fas fa-lock me-1"></i>
                Tu información se mantiene protegida.
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Login/restablecerContrasenia.js?v=@(DateTime.Now.Ticks)"></script>
}
