
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Restablecer Contraseña</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <link href="~/css/Login/RestablecerContrasneia.css" rel="stylesheet" />

</head>

<body>

    <main class="update-page">

        <div class="update-wrapper">

            <div class="login-container">

                <!-- =====================================================
                     HEADER
                     ===================================================== -->

                <div class="login-header">

                    <div class="security-icon">
                        <i class="fas fa-key"></i>
                    </div>

                    <h2>Restablecer Contraseña</h2>

                    <p>
                        Confirma tu correo electrónico para recibir
                        un código de recuperación.
                    </p>

                </div>


                <!-- =====================================================
                     BODY
                     ===================================================== -->

                <div class="login-body">

                    <form id="loginForm" autocomplete="off">


                        <!-- =================================================
                             CORREO
                             ================================================= -->

                        <div class="mb-4">

                            <label for="TxtMailContra"
                                   class="form-label">

                                Correo electrónico

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="fas fa-envelope"></i>
                                </span>

                                <input type="email"
                                       class="form-control"
                                       id="TxtMailContra"
                                       placeholder="ejemplo@correo.com"
                                       required>

                            </div>

                        </div>


                        <!-- =================================================
                             CONFIRMAR CORREO
                             ================================================= -->

                        <div class="mb-4">

                            <label for="TxtMailContraConfirm"
                                   class="form-label">

                                Confirmar correo electrónico

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="fas fa-envelope"></i>
                                </span>

                                <input type="email"
                                       class="form-control"
                                       id="TxtMailContraConfirm"
                                       placeholder="Repite tu correo electrónico"
                                       required>

                            </div>

                        </div>


                        <!-- =================================================
                             VALIDACIÓN ROBOT
                             ================================================= -->

                        <div class="robot-container">

                            <div class="form-check">

                                <input class="form-check-input"
                                       type="checkbox"
                                       id="chkNoRobot">

                                <label class="form-check-label"
                                       for="chkNoRobot">

                                    <i class="fas fa-shield-halved me-1"></i>

                                    No soy un robot

                                </label>

                            </div>

                        </div>


                        <!-- ERROR -->
                        <span id="robotError"
                              class="robot-error d-none">

                            <i class="fas fa-circle-exclamation me-1"></i>

                            Debes confirmar que no eres un robot

                        </span>


                        <!-- =================================================
                             BOTONES
                             ================================================= -->

                        <div class="LoginButtons">

                            <button type="button"
                                    class="btn btn-back"
                                    id="btnBackIndex">

                                <i class="fas fa-arrow-left me-2"></i>

                                Regresar

                            </button>


                            <button type="button"
                                    class="btn btn-login"
                                    id="btnContinuarContra">

                                Continuar

                                <i class="fas fa-arrow-right ms-2"></i>

                            </button>

                        </div>

                    </form>

                </div>

            </div>


            <!-- =========================================================
                 FOOTER
                 ========================================================= -->

            <div class="security-footer">

                <i class="fas fa-lock me-1"></i>

                Tu información se mantiene protegida.

            </div>

        </div>

    </main>


    <!-- =============================================================
         SCRIPTS
         ============================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/js/Login/restablecerContrasenia.js?v=@(DateTime.Now.Ticks)"></script>

</body>

</html>

