@{
    ViewData["Title"] = "Trámites y servicios";
}

@section Styles {
    <link href="~/css/landing.css" asp-append-version="true" rel="stylesheet" />
    <style>
        .tramites-grid {
            grid-template-columns: minmax(0, 460px);
            justify-content: center;
        }
    </style>
}

<section class="landing-hero">
    <div class="landing-hero-inner">
        <span class="landing-eyebrow"><i class="fa-solid fa-file-signature"></i> Trámites</span>
        <h1>Trámites y servicios</h1>
        <p>Consulta los trámites disponibles y los requisitos para realizarlos.</p>
    </div>
</section>

<section class="landing-section">
    <h2 class="landing-section-title">Trámites disponibles</h2>

    <div class="landing-grid tramites-grid">
        <a asp-controller="HojaAdeudo" asp-action="HojaAdeudo" class="landing-card">
            <i class="fa-solid fa-file-circle-check"></i>
            <h3>Carta de no adeudo</h3>
            <p>Consulta los requisitos y descarga la documentación del trámite.</p>
        </a>
    </div>

    <p class="text-muted text-center mt-4 mb-0">
        Próximamente se agregarán más trámites y servicios.
    </p>
</section>
