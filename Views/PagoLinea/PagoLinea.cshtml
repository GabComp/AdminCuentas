@{
    ViewBag.Title = "Pago por Cuenta";
}
<link rel="stylesheet" href="../css/PagoLinea/PagoLinea.css" asp-append-version="true" />

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <!-- Pago -->
            <div class="mb-5">

                <h1 class="titulo-principal">
                    Paga solo con tu cuenta
                </h1>

                <p class="texto-descripcion">
                    Pague su recibo de manera fácil, rápida e inmediata solamente
                    con su número de cuenta.
                </p>

                <div class="mt-4">
                    <label class="form-label etiqueta">
                        Cuenta:
                    </label>

                    <input type="text"
                           class="form-control input-cuenta"
                           placeholder=""
                           maxlength="12" />
                </div>

                <div class="mt-3">
                    <button class="btn btn-pagar">
                        Pagar
                    </button>
                </div>

            </div>
        </div>
    </div>

</div>