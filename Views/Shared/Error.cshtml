@model ErrorViewModel
@{
    var statusCode = ViewData["StatusCode"] as int?;
    var esNoEncontrada = statusCode == 404;
    ViewData["Title"] = esNoEncontrada ? "Página no encontrada" : "Error";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 text-center">
                <div class="mb-3">
                    <i class="fa-solid @(esNoEncontrada ? "fa-map-location-dot" : "fa-triangle-exclamation")"
                       style="font-size: 3rem; color: #691C32;" aria-hidden="true"></i>
                </div>

                <h1 class="h3 mb-3">@(esNoEncontrada ? "Página no encontrada" : "No pudimos completar la solicitud")</h1>

                <p class="text-muted mb-4">
                    @(esNoEncontrada
                        ? "La página que buscas no existe o cambió de lugar."
                        : "Ocurrió un error inesperado. Intenta de nuevo o regresa al inicio.")
                </p>

                @if (Model.ShowRequestId)
                {
                    <p class="small text-muted">
                        Folio de referencia: <code>@Model.RequestId</code>
                    </p>
                }

                <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                    <a href="/Home/Inicio" class="btn btn-primary">
                        <i class="fa-solid fa-house me-1"></i> Ir al inicio
                    </a>
                    <a href="/Home/Menu" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-table-columns me-1"></i> Ir al menú
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
