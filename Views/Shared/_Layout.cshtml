<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - COMAPA Victoria</title>

    <!-- Google Fonts: Montserrat y Open Sans para la identidad institucional -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">

    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">

    <!-- Barra Superior Institucional (Top Bar) -->
    <div class="top-bar">
        <div class="container top-bar-content">
            <div class="gob-tag">
                <span>Ciudad Victoria | COMAPA Victoria</span>
            </div>
            <div class="top-bar-right">
                <div class="top-contacts">
                    <a href="tel:8343187200" class="top-phone">
                        <i class="fa-solid fa-phone"></i> Atención: (834) 318 7200
                    </a>
                </div>
                <div class="social-links-top">
                    <a href="https://facebook.com" target="_blank" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="https://twitter.com" target="_blank" aria-label="Twitter"><i class="fa-brands fa-x-twitter"></i></a>
                    <a href="https://instagram.com" target="_blank" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                    <a href="https://whatsapp.com" target="_blank" aria-label="WhatsApp"><i class="fa-brands fa-whatsapp"></i></a>
                </div>
            </div>
        </div>
    </div>

    <!-- Header y Navegación Principal -->
    <header class="header-comapa">
        <nav class="main-navbar">
            <div class="container nav-container">

                <!-- Logo Institucional -->
                <div class="brand-logo">
                    <a asp-area="" asp-controller="Home" asp-action="Menu">
                        <img src="~/img/logo-comapa.png" alt="Logo Comapa" class="logo-img" />
                    </a>
                </div>

                <!-- Botón Hamburguesa (Móviles) -->
                <button class="mobile-toggle" id="mobileToggle" aria-label="Abrir menú">
                    <span class="bar"></span>
                    <span class="bar"></span>
                    <span class="bar"></span>
                </button>

                <!-- Lista de Enlaces Principales -->
                <ul class="nav-list" id="navList">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Menu">
                            <span class="nav-link-content">
                                <i class="fa-solid fa-house-chimney"></i> 
                                Inicio
                            </span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Recibos" asp-action="Recibos">
                            <span class="nav-link-content">
                                <i class="fa-solid fa-file-invoice-dollar"></i> 
                                Consultar Recibos
                            </span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="HojaAdeudo" asp-action="HojaAdeudo">
                            <span class="nav-link-content">
                                <i class="fas fa-file-circle-check"></i> 
                                Hoja de no Adeudo
                            </span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="AdministradorDeCuentas" asp-action="AdministradorDeCuentas">
                            <span class="nav-link-content">
                                <i class="fa-solid fa-users-gear"></i> 
                                Administrar Cuenta
                            </span>
                        </a>
                    </li>

                    <!-- Menú Desplegable de Usuario (Mi Perfil) -->
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <span class="nav-link-content">
                                <i class="fa-solid fa-circle-user"></i> <span id="nombreUsuarioBadge">Mi Perfil</span>
                            </span>
                            <i class="fa-solid fa-chevron-down arrow"></i>
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a href="/Home/ActualizarDatos">
                                    <i class="fa-solid fa-user-pen me-2 text-muted"></i> Actualizar Datos
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a href="/Home/index" class="text-danger fw-bold">
                                    <i class="fa-solid fa-right-from-bracket me-2"></i> Cerrar Sesión
                                </a>
                            </li>
                        </ul>
                    </li>

                    @* <!-- Botón Destacado de Pago al final del menú móvil -->
                    <li class="nav-item nav-btn-wrapper">
                        <a class="btn-pago-main" asp-area="" asp-controller="Recibos" asp-action="Recibos">
                            <i class="fa-solid fa-credit-card me-1"></i> Pagar Recibo
                        </a>
                    </li> *@
                </ul>

            </div>
        </nav>
    </header>

    <!-- Contenido Principal -->
    <div class="container" style="margin-top: 40px; min-height: 80vh;">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer Moderno -->
    <footer class="main-footer">
        <div class="container">
            <div class="footer-top">
                <div class="brand-col">
                    <img src="~/img/logo-comapa.png" alt="Logo Comapa" class="footer-logo" />
                    <p>Comisión Municipal de Agua Potable y Alcantarillado de Victoria. Trabajando por el bienestar de las familias victorenses.</p>
                </div>
                <div class="contact-col">
                    <h4>Contacto</h4>
                    <p><i class="fa-solid fa-location-dot me-2"></i> Zitácuaro #205, Col. Burócratas State, C.P. 87025, Ciudad Victoria, Tamaulipas.</p>
                    <p><i class="fa-solid fa-phone me-2"></i> (834) 318 7200</p>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container footer-bottom-content">
                <small>&copy; @DateTime.Now.Year - COMAPA Victoria. Todos los derechos reservados.</small>
            </div>
        </div>
    </footer>

    <!-- Botón para subir -->
    <button id="btnSubir" aria-label="Ir arriba">
        <i class="fa-solid fa-arrow-up"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Script sencillo para hacer funcionar el menú hamburguesa móvil en este layout -->
    <script>
        $(document).ready(function () {
            $('#mobileToggle').on('click', function () {
                $('#navList').toggleClass('active');
            });

            // Toggle para dropdown en móvil si hace clic en el enlace padre
            $('.nav-item > .nav-link').on('click', function (e) {
                if ($(window).width() <= 992 && $(this.nextElementSibling).hasClass('dropdown-menu')) {
                    e.preventDefault();
                    $(this).parent('.nav-item').toggleClass('open');
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>