<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AdministradorDeCuentas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    @* <link rel="stylesheet" href="~/AdministradorDeCuentas.styles.css" asp-append-version="true" /> *@
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow " id="navBar">
            <div class="container-fluid" id="contenedorBar">
                @* <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">PrototipoComapa</a> *@
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between" id="bar">
                    <div id="logoPerfil">
                        <a class="" asp-area="" asp-controller="Home" asp-action="Menu">
                            @* 190X80 *@
                            <span>
                                <svg width="200" height="70" viewBox="0 0 200 70" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                                    <rect y="-8" width="300" height="150" fill="url(#pattern0_1_4750)" />
                                    <defs>
                                        <pattern id="pattern0_1_4750" patternContentUnits="objectBoundingBox" width="1" height="1">
                                            <use xlink:href="#image0_1_4750" transform="matrix(0.00338308 0 0 0.00666667 -0.00238806 0)" />
                                        </pattern>
                                        <image id="image0_1_4750" width="180" height="80" preserveAspectRatio="none" xlink:href="data:image/png;base64," />
                                    </defs>
                                </svg>
                            </span>
                        </a>
                        @* <div id="">
                            <a id="perfiLink" href="/Home/ActualizarDatos">Perfil</a>
                        </div> *@
                        <div id="Menu" class="perfilUsuario">
                            <ul class="navbar-nav flex-grow-1" id="MenuList">
                                <li class="nav-item">
                                    <a class="nav-link perfilUsuario" id="perfiLink" onclick="return false;"></a>
                                    <ul class="navbar-nav flex-grow-1 menuItem">
                                        <li><a class="nav-link" href="/Home/ActualizarDatos">Actuallizar Datos del Perfil</a></li>
                                        <li><a class="nav-link" href="/Home/index">Cerrar Sesion</a></li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    </div>


                    <div id="Menu">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Menu">Menu</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="AdministradorDeCuentas" asp-action="AdministradorDeCuentas">Administrar Cuenta</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Recibos" asp-action="Recibos">Consultar Recibos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Recibos" asp-action="Recibos">Pago en Linea</a>
                            </li>
                            @* <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                            </li> *@
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

   @*  <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - AdministradorDeCuentas - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer> *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
