<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <partial name="_AntiforgeryMeta" />
    <title>@ViewData["Title"] - COMAPA Victoria</title>

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">

    <header class="header-comapa">
        <nav class="main-navbar">
            <div class="container nav-container">
                <div class="brand-logo">
                    <a href="/" aria-label="COMAPA Victoria">
                        <img src="~/img/logo-comapa.png" alt="Logo COMAPA Victoria" class="logo-img" />
                    </a>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="fw-semibold" style="color: var(--color-gob-guinda);">Pago en línea</span>
                </div>
            </div>
        </nav>
    </header>

    <main class="container" style="margin-top: 30px; min-height: 80vh;">
        @RenderBody()
    </main>

    <footer class="main-footer">
        <div class="container text-center py-4">
            <p class="mb-1">
                <i class="fa-solid fa-phone me-2"></i>
                ¿Necesitas ayuda? <a href="tel:8343187200">(834) 318 7200</a>
            </p>
            <p class="mb-1">
                <a href="/Home/Privacy">Aviso de privacidad</a>
            </p>
            <small>&copy; @DateTime.Now.Year - COMAPA Victoria. Todos los derechos reservados.</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
