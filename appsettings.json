{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiSettings": {
    // ComapaInternet.Api: API única del portal.
    // BaseUrl se usa para /API/Transaction (login, registro y cuentas).
    // En producción debe apuntar a HTTPS.
    "BaseUrl": "http://localhost:5058/",

    // ComapaInternet.Api (recibos y pagos). Debe terminar en /api/.
    // En producción apuntar al mismo dominio que BaseUrl.
    "Recibos": "http://localhost:5058/api/",
    "RecibosApiKey": "",
    // Credenciales del usuario de servicio de la API de recibos.
    // Nunca deben llegar al navegador. Configurar por user-secrets o variables de entorno.
    "RecibosLoginUser": "",
    "RecibosLoginPassword": "",

    // Usuario interno que se envía en AplicarPago y forma de pago configurada.
    "RecibosUsuario": "U0293",
    "RecibosFormaPago": 4,

    // Interruptor de seguridad: por defecto el pago no se aplica.
    "PermitirAplicarPago": false
  },
  "Evo": {
    // Producción: configurar por variables de entorno / Key Vault.
    // En desarrollo, los valores de prueba están en appsettings.Development.json.
    "Merchant": "",
    "User": "",
    "Password": "",
    "InitiateCheckoutUrl": "",
    "RetrieveOrderUrl": "",
    "CheckoutScriptUrl": "",
    "MerchantName": "COMAPA VICTORIA",
    "MerchantLogo": "",
    "MerchantUrl": "",
    // Si se dejan vacías, el portal las construye con el host de la petición.
    "ReturnUrl": "",
    "CancelUrl": ""
  },
  "Resend": {
    // Si se define ApiKey, el correo sale por la API HTTP de Resend (443)
    // y no se usa SMTP.
    "ApiKey": "",
    "From": ""
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "From": "",
    "EnableSsl": true
  },
  "Portal": {
    // URL pública https del portal. Se usa para enlaces de correo y retorno de pagos.
    "PublicBaseUrl": ""
  },
  "ForwardedHeaders": {
    // En producción configure los proxies/redes reales del balanceador.
    // Si se activa sin valores, el portal no arranca.
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Csp": {
    // Orígenes adicionales si la pasarela o un CDN cambian.
    // Ejemplo: "https://checkout.evopayments.com"
    "AdditionalScriptOrigins": [],
    "AdditionalStyleOrigins": [],
    "AdditionalConnectOrigins": [],
    "AdditionalFrameOrigins": []
  }
}
